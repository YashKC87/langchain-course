# Application
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AUTH_ENABLED=false
DEFAULT_ROLE=platform_administrator

# Content capture — prompts/responses OFF by default
CONTENT_CAPTURE_ENABLED=false
PII_REDACTION_ENABLED=true
TELEMETRY_SAMPLING_RATE=1.0

# Thresholds
DEFAULT_AUTO_REFRESH_SECONDS=30
RUNAWAY_STEPS_WARNING=8
RUNAWAY_STEPS_HIGH=13
RUNAWAY_STEPS_CRITICAL=21
RUNAWAY_RETRY_THRESHOLD=5
RUNAWAY_FALLBACK_THRESHOLD=3
LATENCY_WARNING_MS=2000
LATENCY_CRITICAL_MS=10000
TELEMETRY_STALE_SECONDS=120
TELEMETRY_OFFLINE_SECONDS=600
TELEMETRY_RETENTION_DAYS=30

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# Microsoft Azure (optional — pre-fills Integrations → Microsoft Azure)
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# AZURE_RESOURCE_GROUP=my-resource-group
# AZURE_FOUNDRY_PROJECT=my-foundry-project
# AZURE_APP_INSIGHTS=my-app-insights
# AZURE_LOG_ANALYTICS=my-log-analytics-workspace
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=set-in-secret-store-not-in-git

# AWS (optional)
# AWS_ACCOUNT_ID=123456789012
# AWS_REGION=us-east-1
# AWS_AUTH_METHOD=IAM Role

# Google Cloud (optional)
# GCP_PROJECT_ID=my-gcp-project
# GCP_REGION=us-central1
# GCP_AUTH_METHOD=Workload Identity

# OpenTelemetry ingest (agents / collector export here)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Frontend — leave unset in dev to use same-origin /api/v1 proxy
# VITE_API_URL=http://localhost:8000/api/v1
