# Application
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AUTH_ENABLED=false
DEFAULT_ROLE=platform_administrator

# Content capture — prompts/responses OFF by default
CONTENT_CAPTURE_ENABLED=false
PII_REDACTION_ENABLED=true
TELEMETRY_SAMPLING_RATE=1.0

# Thresholds
DEFAULT_AUTO_REFRESH_SECONDS=30
RUNAWAY_STEPS_WARNING=8
RUNAWAY_STEPS_HIGH=13
RUNAWAY_STEPS_CRITICAL=21
RUNAWAY_RETRY_THRESHOLD=5
RUNAWAY_FALLBACK_THRESHOLD=3
LATENCY_WARNING_MS=2000
LATENCY_CRITICAL_MS=10000
TELEMETRY_STALE_SECONDS=120
TELEMETRY_OFFLINE_SECONDS=600
TELEMETRY_RETENTION_DAYS=30

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# Provider placeholders — use secret stores / IAM in production
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AWS_REGION=
# GCP_PROJECT_ID=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
