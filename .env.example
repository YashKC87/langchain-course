# Application
DEMO_MODE=true
APP_NAME=SLM + Frontier Device Monitoring Patterns
LOG_LEVEL=INFO

# Local SLM (Ollama-compatible)
SLM_PROVIDER=ollama
SLM_MODEL=llama3.2
SLM_BASE_URL=http://localhost:11434
SLM_TIMEOUT_SECONDS=60

# Frontier (Azure OpenAI-compatible abstraction)
FRONTIER_PROVIDER=azure_openai
FRONTIER_MODEL=gpt-4o
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=

# LangSmith
LANGSMITH_ENABLED=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=slm-frontier-device-monitoring
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Illustrative pricing — configure using current provider pricing.
# Values are USD per 1K tokens and are NOT factual market prices.
ILLUSTRATIVE_SLM_INPUT_COST_PER_1K=0.0001
ILLUSTRATIVE_SLM_OUTPUT_COST_PER_1K=0.0002
ILLUSTRATIVE_FRONTIER_INPUT_COST_PER_1K=0.005
ILLUSTRATIVE_FRONTIER_OUTPUT_COST_PER_1K=0.015

# Confidence cascade threshold
CONFIDENCE_THRESHOLD=0.85

# API
API_HOST=0.0.0.0
API_PORT=8000
