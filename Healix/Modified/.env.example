# ============================================================
#  HEALIX Configuration — Environment Variables
#  Copy this file to .env and fill in your values
# ============================================================

# === OpenAI (existing) ===
OPENAI_API_KEY=your-openai-api-key-here

# === Azure AD / Entra ID App Registration ===
# Register an app at https://portal.azure.com → Azure Active Directory → App registrations
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Required API Permissions (Application permissions):
#   Microsoft Graph:
#     - SecurityEvents.Read.All
#     - SecurityIncident.Read.All
#     - ThreatHunting.Read.All
#     - DeviceManagementManagedDevices.Read.All
#     - DeviceManagementConfiguration.Read.All
#     - IdentityRiskEvent.Read.All
#     - IdentityRiskyUser.Read.All
#     - AuditLog.Read.All
#     - Directory.Read.All
#     - Mail.Send
#     - User.Read.All
#   Azure Service Management:
#     - user_impersonation (for Log Analytics)

# === Microsoft Sentinel / Log Analytics ===
SENTINEL_WORKSPACE_ID=your-workspace-id
SENTINEL_RESOURCE_GROUP=your-resource-group
SENTINEL_SUBSCRIPTION_ID=your-subscription-id

# === Alert Delivery — Microsoft Teams ===
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-webhook-url

# === Alert Delivery — Email (SMTP) ===
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASSWORD=your-smtp-password
ALERT_EMAIL_RECIPIENTS=ops-team@yourdomain.com,security@yourdomain.com

# === Application Settings ===
HEALIX_DB_PATH=./healix.db
HEALIX_LOG_LEVEL=INFO
HEALIX_POLLING_INTERVAL_SECONDS=60
# demo_mode: "auto" (detect from credentials), "always" (force demo), "never" (require real APIs)
HEALIX_DEMO_MODE=auto
